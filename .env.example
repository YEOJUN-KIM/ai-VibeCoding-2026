# 로컬 실행에 필요한 최소 설정입니다.
# 이 파일을 `.env`로 복사한 뒤 실제 값을 입력하세요.
# 비밀값이 들어간 `.env`는 Git에 올리지 마세요.

# 토스증권 Open API
# 공인 IP는 이 파일에 입력하는 값이 아닙니다.
# 토스증권 Open API 관리 화면에 현재 사용 중인 공인 IP를 등록하세요.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# 실제 주문 전송 안전 잠금입니다. 연결부 검증이 끝날 때까지 false로 유지하세요.
LIVE_TRADING_ENABLED=false

# PAPER 체결당 불리한 가격 차이 가정: 0.0005 = 0.05%, 실제 호가 측정값이 아님
PAPER_SLIPPAGE_RATE=0.0005
# 실제 시세 확인 주기. 완료된 이동평균 봉 주기는 항상 1분이며 재주문 대기와 별개
STRATEGY_INTERVAL_SECONDS=10

# 서버 실행 중 평일 한국 장중에 WATCH_SYMBOLS의 완료 1분봉을 매분 저장합니다.
ML_DATA_COLLECTION_ENABLED=true
# 매번 다시 확인할 최근 봉 수. 중복 봉은 DB 기본키로 추가되지 않습니다.
ML_DATA_COLLECTION_COUNT=20
ML_MARKET_INDICATORS=KOSPI,KOSDAQ
# 장 마감 후 ML 원본 데이터 품질 보고서 생성 시각(한국시간)
ML_QUALITY_REPORT_HOUR=15
ML_QUALITY_REPORT_MINUTE=40

# 토스 계좌가 여러 개일 때만 아래 항목의 주석을 풀고 사용할 accountSeq를 입력하세요.
# TOSS_ACCOUNT=

# 기업정보·재무·배당·공시 (OpenDART)
# https://opendart.fss.or.kr/ 에서 인증키를 발급받은 뒤 입력하세요.
# 키가 없어도 토스 기반 종목정보와 차트는 정상 작동합니다.
DART_API_KEY=

# 장기 관찰 후보 자동 갱신 시각 (한국시간, 기본 매일 04:30)
LONG_TERM_SCAN_HOUR=4
LONG_TERM_SCAN_MINUTE=30


# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=auto_trader
POSTGRES_USER=paper_local
POSTGRES_PASSWORD=
# Optional: select a Windows service only when multiple PostgreSQL versions are installed.
# POSTGRES_SERVICE=postgresql-x64-18



# OpenAI 뉴스 브리핑
# 서버 구현은 되어 있지만 비용과 기사 이용 범위를 결정할 때까지 비활성화합니다.
# 나중에 사용할 때만 AI_NEWS_ENABLED=true로 바꾸고 API 키를 입력하세요.
AI_NEWS_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_API_BASE_URL=https://api.openai.com/v1

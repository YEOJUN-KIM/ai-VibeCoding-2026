# ============================================================
# 국내주식 자동매매 프로그램 설정 예시
# 이 파일을 .env로 복사한 뒤 필요한 값을 입력하세요.
# 실제 Client Secret이 들어간 .env는 Git에 올리면 안 됩니다.
# ============================================================

# 프로그램 실행
APP_HOST=127.0.0.1
APP_PORT=8000
APP_MODE=PAPER
APP_RELOAD=false
SESSION_MINUTES=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# 모의투자
PAPER_INITIAL_CASH=10000000
# 모의 계산용 예시 비율이며 실제 증권사 수수료/현행 세율이 아닙니다.
# 매수·매도 수수료 0.015%, 매도 세금 0.2%, 건별 원 미만 절사
PAPER_FEE_RATE=0.00015
PAPER_SELL_TAX_RATE=0.002
WATCH_SYMBOLS=005930,000660,005380,035420,035720,005490,051910,006400,105560,055550

# 이동평균 자동매매 전략
STRATEGY_INTERVAL_SECONDS=2
STRATEGY_SHORT_PERIOD=5
STRATEGY_LONG_PERIOD=20
ORDER_QUANTITY=1

# 토스증권 Open API
# API를 발급받기 전에는 빈 값으로 두세요.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT=
TOSS_ALLOWED_IP=
TOSS_API_BASE_URL=https://openapi.tossinvest.com
TOSS_WS_URL=wss://openapi-ws.tossinvest.com/ws/v1

# OpenAI 뉴스 브리핑
# 구현 보류 상태입니다. 나중에 사용할 때만 true로 바꾸고 키를 입력하세요.
AI_NEWS_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_API_BASE_URL=https://api.openai.com/v1

# PostgreSQL
# PostgreSQL을 설치하고 데이터베이스를 만든 후 입력하세요.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=auto_trader
POSTGRES_USER=paper_local
POSTGRES_PASSWORD=
